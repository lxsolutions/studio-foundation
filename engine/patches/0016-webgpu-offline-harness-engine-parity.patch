diff --git a/drivers/webgpu/tint_cli/build_glsl2spv.sh b/drivers/webgpu/tint_cli/build_glsl2spv.sh
new file mode 100644
--- /dev/null
+++ b/drivers/webgpu/tint_cli/build_glsl2spv.sh
@@ -0,0 +1,112 @@
+#!/usr/bin/env bash
+# Build glsl2spv — native GLSL -> SPIR-V compiler using Godot's vendored glslang.
+#
+# Companion to tint_cli/build.sh (which builds tint_convert_cli). Kept separate
+# because glsl2spv only needs glslang, not Tint + SPIRV-Tools, so it builds in
+# ~1 minute instead of ~30.
+#
+# Source list and defines mirror modules/glslang/SCsub exactly, so the offline
+# harness compiles shaders the same way the engine does.
+#
+# Usage: ./drivers/webgpu/tint_cli/build_glsl2spv.sh [--clean]
+# Output: bin/glsl2spv
+set -euo pipefail
+
+SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
+REPO_ROOT="$(cd "$SCRIPT_DIR/../../.." && pwd)"
+cd "$REPO_ROOT"
+
+GLSLANG_DIR="thirdparty/glslang"
+SPIRV_HEADERS_DIR="thirdparty/spirv-headers"
+BUILD_DIR="drivers/webgpu/tint_cli/.build/glslang"
+CXX="${CXX:-g++}"
+JOBS=$(nproc 2>/dev/null || echo 4)
+
+for arg in "$@"; do
+    [[ "$arg" == "--clean" ]] && rm -rf "$BUILD_DIR"
+done
+mkdir -p "$BUILD_DIR"
+
+# Source list from modules/glslang/SCsub.
+SOURCES=(
+    "glslang/GenericCodeGen/CodeGen.cpp"
+    "glslang/GenericCodeGen/Link.cpp"
+    "glslang/MachineIndependent/attribute.cpp"
+    "glslang/MachineIndependent/Constant.cpp"
+    "glslang/MachineIndependent/glslang_tab.cpp"
+    "glslang/MachineIndependent/InfoSink.cpp"
+    "glslang/MachineIndependent/Initialize.cpp"
+    "glslang/MachineIndependent/Intermediate.cpp"
+    "glslang/MachineIndependent/intermOut.cpp"
+    "glslang/MachineIndependent/IntermTraverse.cpp"
+    "glslang/MachineIndependent/iomapper.cpp"
+    "glslang/MachineIndependent/limits.cpp"
+    "glslang/MachineIndependent/linkValidate.cpp"
+    "glslang/MachineIndependent/parseConst.cpp"
+    "glslang/MachineIndependent/ParseContextBase.cpp"
+    "glslang/MachineIndependent/ParseHelper.cpp"
+    "glslang/MachineIndependent/PoolAlloc.cpp"
+    "glslang/MachineIndependent/preprocessor/PpAtom.cpp"
+    "glslang/MachineIndependent/preprocessor/PpContext.cpp"
+    "glslang/MachineIndependent/preprocessor/Pp.cpp"
+    "glslang/MachineIndependent/preprocessor/PpScanner.cpp"
+    "glslang/MachineIndependent/preprocessor/PpTokens.cpp"
+    "glslang/MachineIndependent/propagateNoContraction.cpp"
+    "glslang/MachineIndependent/reflection.cpp"
+    "glslang/MachineIndependent/RemoveTree.cpp"
+    "glslang/MachineIndependent/Scan.cpp"
+    "glslang/MachineIndependent/ShaderLang.cpp"
+    "glslang/MachineIndependent/SpirvIntrinsics.cpp"
+    "glslang/MachineIndependent/SymbolTable.cpp"
+    "glslang/MachineIndependent/Versions.cpp"
+    "glslang/ResourceLimits/ResourceLimits.cpp"
+    "SPIRV/disassemble.cpp"
+    "SPIRV/doc.cpp"
+    "SPIRV/GlslangToSpv.cpp"
+    "SPIRV/InReadableOrder.cpp"
+    "SPIRV/Logger.cpp"
+    "SPIRV/SpvBuilder.cpp"
+    "SPIRV/SpvPostProcess.cpp"
+    "SPIRV/SpvTools.cpp"
+)
+
+case "$(uname -s)" in
+    Linux|Darwin) SOURCES+=("glslang/OSDependent/Unix/ossource.cpp") ;;
+    *)            SOURCES+=("glslang/OSDependent/Windows/ossource.cpp") ;;
+esac
+
+INCLUDES=(
+    -I"$GLSLANG_DIR"
+    -I"thirdparty"
+    -I"$SPIRV_HEADERS_DIR/include/spirv/unified1"
+)
+# ENABLE_OPT=0 matches SCsub (no SPIRV-Tools optimizer dependency).
+DEFINES=(-DENABLE_OPT=0)
+FLAGS=(-O2 -w -std=c++17)
+
+echo "[1/2] Compiling glslang (${#SOURCES[@]} sources)..."
+OBJS=()
+for src in "${SOURCES[@]}"; do
+    obj="$BUILD_DIR/${src%.cpp}.o"
+    OBJS+=("$obj")
+    if [[ -f "$obj" && "$obj" -nt "$GLSLANG_DIR/$src" ]]; then
+        continue
+    fi
+    mkdir -p "$(dirname "$obj")"
+    $CXX -c "$GLSLANG_DIR/$src" -o "$obj" "${FLAGS[@]}" "${INCLUDES[@]}" "${DEFINES[@]}" &
+    while (( $(jobs -r | wc -l) >= JOBS )); do wait -n 2>/dev/null || true; done
+done
+wait
+
+echo "[2/2] Compiling + linking glsl2spv..."
+mkdir -p bin
+# Static-link the toolchain runtime. On Windows a MinGW-built exe otherwise dies
+# with 0xC0000139 (STATUS_ENTRYPOINT_NOT_FOUND) as soon as it is launched from
+# outside the MinGW shell, because a different libstdc++/libgcc is found first
+# on PATH. Static linking makes the harness runnable from Python/PowerShell.
+LINK_FLAGS=(-static -static-libgcc -static-libstdc++)
+$CXX drivers/webgpu/tint_cli/glsl2spv.cpp -o bin/glsl2spv \
+    "${FLAGS[@]}" "${INCLUDES[@]}" "${DEFINES[@]}" "${OBJS[@]}" "${LINK_FLAGS[@]}"
+
+echo ""
+echo "Built: bin/glsl2spv ($(du -h bin/glsl2spv | cut -f1))"
diff --git a/drivers/webgpu/tint_cli/probe_one.py b/drivers/webgpu/tint_cli/probe_one.py
new file mode 100644
--- /dev/null
+++ b/drivers/webgpu/tint_cli/probe_one.py
@@ -0,0 +1,51 @@
+"""Compile one shader variant and run it through Tint by hand, printing raw errors.
+
+The batch sweep only reports pass/fail counts, which hides whether a failure is
+Tint rejecting the module or the harness failing to invoke Tint at all.
+
+Usage: python probe_one.py <repo_root> <glsl2spv> <shader-substr> <stage> [variant]
+"""
+
+import os
+import subprocess
+import sys
+
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), ".."))
+import wgsl_precompile as W  # noqa: E402
+
+repo_root, glslang, want, want_stage = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
+want_variant = sys.argv[5] if len(sys.argv) > 5 else None
+
+tint = os.path.join(repo_root, "bin", "tint_convert_cli")
+print(f"tint_convert_cli present: {os.path.isfile(tint)} -> {tint}")
+
+
+# Reuse the sweep's own shader/variant enumeration, but intercept the conversion
+# step so we can run the one module we care about on its own and see the raw error.
+def stop_batch(spv_files, tint_cli_path):
+    # Grab the first matching module, convert it alone, and print everything.
+    for key, path in spv_files:
+        if want not in key:
+            continue
+        if f":{want_stage}" not in key:
+            continue
+        if want_variant and f":{want_variant}:" not in key:
+            continue
+        size = os.path.getsize(path)
+        with open(path, "rb") as f:
+            header = f.read(8)
+        # SPIR-V header word 1 is the version: 0x00010300 == 1.3
+        ver = int.from_bytes(header[4:8], "little")
+        print(f"\nMATCH {key}\n  spv bytes: {size}  version: 0x{ver:08x} "
+              f"({(ver >> 16) & 0xFF}.{(ver >> 8) & 0xFF})")
+        r = subprocess.run([tint_cli_path, path], capture_output=True, text=True, timeout=120)
+        print(f"  tint exit: {r.returncode}")
+        print(f"  stderr: {r.stderr[:1500]}")
+        print(f"  stdout[:300]: {r.stdout[:300]}")
+        raise SystemExit(0)
+    print(f"\nNo module matched {want}:{want_stage}")
+    raise SystemExit(1)
+
+
+W.convert_spirv_batch = stop_batch
+W.precompile_wgsl(repo_root, os.devnull, glslang)
