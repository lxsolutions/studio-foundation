{
  // Scoped to the browser runtime: TypeScript game templates plus the gauntlet
  // runtime contract. The harness itself stays plain .mjs Node tooling.
  //
  // `tsc --noEmit` is the preflight gate in tools/gauntlet/harness/round.mjs.
  // It exists because a capture round costs minutes on the GPU host and a
  // typecheck costs seconds (ADR 0017).
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    // Emit .js beside each .ts. The templates load through an import map with
    // no bundler, which keeps one less step between an edit and a frame.
    "sourceMap": true,
    // A failed build must not leave the previous .js in place for the harness
    // to capture. Emit only on success.
    "noEmitOnError": true,
    "paths": {
      // Served by tools/gauntlet/harness/serve.mjs with --root at the repo root,
      // so browser URLs and disk paths line up.
      "/tools/gauntlet/runtime/*": ["./tools/gauntlet/runtime/*"],
      "three/addons/*": [
        "./node_modules/@types/three/examples/jsm/*",
        "./node_modules/three/examples/jsm/*"
      ]
    }
  },
  "include": [
    "templates/three-game/**/*.ts",
    "tools/gauntlet/runtime/**/*.d.ts"
  ],
  "exclude": ["node_modules", "engine", "games", "runs"]
}
